# VPSAgent v2 Runtime Configuration Template
# Never commit a real .env file. bootstrap/install.sh generates strong random secrets automatically.

VPSAGENT_SITE_ADDRESS=:80
VPSAGENT_DOMAIN=localhost
VPSAGENT_ACME_EMAIL=admin@example.com
VPSAGENT_PUBLIC_IP=

# Generated automatically during install
VPSAGENT_RUNTIME_TOKEN=replace-with-64-char-hex-secret
VPSAGENT_SESSION_SECRET=replace-with-64-char-hex-secret
VPSAGENT_ENCRYPTION_SECRET=replace-with-64-char-hex-secret
VPSAGENT_CLAIM_TOKEN=replace-with-single-use-claim-token

# Host Runtime Bridge paths
VPSAGENT_RUNTIME_SOCKET=/var/lib/vpsagent/run/runtime.sock
VPSAGENT_APPS_ROOT=/var/lib/vpsagent/apps
VPSAGENT_CADDY_APPS_DIR=/var/lib/vpsagent/caddy/apps.d
VPSAGENT_CADDY_CONTAINER=vpsagent-caddy
